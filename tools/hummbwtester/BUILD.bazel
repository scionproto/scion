load("@rules_go//go:def.bzl", "go_library")
load("@scion_python_deps//:requirements.bzl", "requirement")
load("//:scion.bzl", "scion_go_binary")
load("//tools:go.bzl", "go_test")
load("//tools/lint:py.bzl", "py_library", "py_test")

go_library(
    name = "go_default_library",
    srcs = [
        "client.go",
        "main.go",
        "metrics.go",
        "packet.go",
        "server.go",
        "stats.go",
    ],
    importpath = "github.com/scionproto/scion/tools/hummbwtester",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/addr:go_default_library",
        "//pkg/daemon:go_default_library",
        "//pkg/daemon/types:go_default_library",
        "//pkg/hummingbird:go_default_library",
        "//pkg/hummingbird/bwencoding:go_default_library",
        "//pkg/hummingbird/marketplace:go_default_library",
        "//pkg/log:go_default_library",
        "//pkg/private/serrors:go_default_library",
        "//pkg/slayers/path/hummingbird:go_default_library",
        "//pkg/snet:go_default_library",
        "//pkg/snet/metrics:go_default_library",
        "//pkg/snet/path:go_default_library",
        "//private/env:go_default_library",
        "//private/keyconf:go_default_library",
        "@com_github_prometheus_client_golang//prometheus:go_default_library",
        "@com_github_prometheus_client_golang//prometheus/promauto:go_default_library",
    ],
)

scion_go_binary(
    name = "hummbwtester",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
    deps = [
        "//pkg/addr:go_default_library",
        "//pkg/slayers/path:go_default_library",
        "//pkg/slayers/path/scion:go_default_library",
        "//pkg/snet:go_default_library",
        "//pkg/snet/path:go_default_library",
        "@com_github_prometheus_client_golang//prometheus/testutil:go_default_library",
        "@com_github_stretchr_testify//assert:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
    ],
)

py_library(
    name = "orchestration",
    srcs = ["orchestration.py", "ssh_orchestration.py"],
    deps = [requirement("pyyaml")],
)

py_test(
    name = "orchestration_test",
    srcs = ["orchestration_test.py"],
    deps = [":orchestration"],
)

py_test(
    name = "ssh_orchestration_test",
    srcs = ["ssh_orchestration_test.py"],
    deps = [":orchestration"],
)
