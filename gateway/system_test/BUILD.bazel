load("//testing/clab:system_test.bzl", "clab_system_test")

# gazelle:map_kind go_test clab_system_test //testing/clab:system_test.bzl

# System test for IP connectivity through SCION IP gateways, in a containerlab
# topology. It needs docker and the clab command.
#
# Run the whole lifecycle:
#   bazel test //gateway/system_test:go_default_test --test_output=streamed
#
# Run the phases separately; the lab stays deployed in between:
#   bazel run //gateway/system_test:go_default_test_setup
#   bazel run //gateway/system_test:go_default_test_run
#   bazel run //gateway/system_test:go_default_test_teardown
clab_system_test(
    name = "go_default_test",
    srcs = ["system_test.go"],
    data = ["//topology:tiny4.topo"],
    env = {
        "CLAB_TOPO": "$(rootpath //topology:tiny4.topo)",
    },
    deps = [
        "//pkg/addr:go_default_library",
        "//testing/clab:go_default_library",
        "//testing/clab/e2e:go_default_library",
        "//testing/clab/testgen/hydrate:go_default_library",
        "@com_github_pelletier_go_toml_v2//:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
        "@in_yaml_go_yaml_v4//:go_default_library",
    ],
)
