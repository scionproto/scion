load("@jq.bzl", "jq")

filegroup(
    name = "topology",
    srcs = ["topology.json"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "invalid_reloads",
    srcs = [
        ":topology_invalid_attributes",
        ":topology_invalid_ia",
        ":topology_invalid_mtu",
    ],
    visibility = ["//visibility:public"],
)

jq(
    name = "topology_invalid_ia",
    srcs = ["topology.json"],
    out = "topology_invalid_ia.json",
    filter = '.isd_as = "1-ff00:0:111"',
)

jq(
    name = "topology_invalid_attributes",
    srcs = ["topology.json"],
    out = "topology_invalid_attributes.json",
    filter = '.attributes = ["core"]',
)

jq(
    name = "topology_invalid_mtu",
    srcs = ["topology.json"],
    out = "topology_invalid_mtu.json",
    filter = ".mtu = 42",
)
