        "@rules_go//go/platform:linux_arm": [
            "sockfilter_bpfel.o",
        ],
        "@rules_go//go/platform:linux_arm64": [
            "sockfilter_bpfel.o",
        ],
        "@rules_go//go/platform:linux_mips64le": [
