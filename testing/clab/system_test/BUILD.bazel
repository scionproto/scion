load("//testing/clab:system_test.bzl", "clab_system_test")

# gazelle:map_kind go_test clab_system_test //testing/clab:system_test.bzl

# System test that drives a containerlab SCION topology end to end (setup,
# execute, teardown). It needs docker and the clab command.
#
# Run the whole lifecycle:
#   bazel test //testing/clab/system_test:go_default_test --test_output=streamed
#
# Run the phases separately; the lab stays deployed in between:
#   bazel run //testing/clab/system_test:go_default_test_setup
#   bazel run //testing/clab/system_test:go_default_test_run
#   bazel run //testing/clab/system_test:go_default_test_teardown
clab_system_test(
    name = "go_default_test",
    srcs = ["system_test.go"],
    data = [
        "//testing/clab/cmd/e2e_http",
        "//testing/clab/cmd/e2e_scion",
        "//topology:default-no-peers.topo",
    ],
    env = {
        "E2E_SCION_BIN": "$(rootpath //testing/clab/cmd/e2e_scion)",
        "E2E_HTTP_BIN": "$(rootpath //testing/clab/cmd/e2e_http)",
        "CLAB_TOPO": "$(rootpath //topology:default-no-peers.topo)",
    },
    deps = [
        "//testing/clab:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
    ],
)
